{
  "name": "@tanaab/merge",
  "version": "0.1.0-beta.1",
  "description": "Composable object and array merge utilities extracted from Lando.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "API.md",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanaabased/merge.git"
  },
  "bugs": {
    "url": "https://github.com/tanaabased/merge/issues"
  },
  "homepage": "https://github.com/tanaabased/merge#readme",
  "packageManager": "bun@1.3.10",
  "engines": {
    "bun": ">=1.3.10",
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "bun run ./scripts/build.ts",
    "lint:eslint": "bun --bun eslint .",
    "format:check": "bun --bun prettier . --check --ignore-unknown",
    "format:write": "bun --bun prettier . --write --ignore-unknown",
    "lint": "bun run lint:eslint && bun run format:check",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun --bun ./node_modules/mocha/bin/mocha.js --extension ts 'test/**/*.spec.ts'",
    "test:package": "bun run build && bun run ./scripts/test-package.ts",
    "docs": "bun run ./scripts/docs-task.ts",
    "docs:check": "bun run ./scripts/docs-task.ts --check"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/lodash": "^4.17.20",
    "@types/mocha": "^10.0.10",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "mocha": "^12.0.1",
    "prettier": "^3.9.6",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
